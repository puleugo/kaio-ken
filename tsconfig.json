{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2017",
		"lib": ["ES6", "DOM"],
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"rootDir": "./",
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,

		"strict": true,
		"noImplicitAny": false,
		"strictNullChecks": true,
		"strictPropertyInitialization": false,
		"noImplicitThis": true,
		"skipLibCheck": true,
		"paths": {
			"@src/*": ["./src/*"],
			"@test/*": ["./test/*"]
		}
	},
	"ts-node": {
		"compilerOptions": {
			"module": "es2022"
		}
	}
}
