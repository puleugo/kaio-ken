{
	"name": "kablog",
	"version": "1.0.0",
	"main": "src/index.js",
	"scripts": {
		"build": "ncc build -m src/index.ts",
		"start": "node dist/index.js",
		"test": "NODE_ENV=test dotenv -e .env jest",
		"lint": "npx @biomejs/biome lint --write",
		"format": "npx @biomejs/biome format --write"
	},
	"author": "puleugo",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@actions/core": "^1.11.1",
		"axios": "1.8.2",
		"class-transformer": "^0.5.1",
		"crypto": "^1.0.1",
		"dayjs": "^1.11.13",
		"dotenv": "^16.4.5",
		"fast-xml-parser": "^4.5.0",
		"yaml": "^2.7.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@eslint/js": "^9.14.0",
		"@faker-js/faker": "^9.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.5.4",
		"@types/xml2js": "^0.4.14",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^5.4.3"
	},
	"jest": {
		"moduleFileExtensions": ["js", "json", "ts"],
		"rootDir": ".",
		"testRegex": ".*\\.test\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": ["**/*.(t|j)s"],
		"modulePaths": ["src"],
		"collectCoverage": true,
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"moduleNameMapper": {
			"^@src/(.*)$": "<rootDir>/src/$1",
			"^@test/(.*)$": "<rootDir>/test/$1"
		},
		"coveragePathIgnorePatterns": ["/node_modules/", "/dist/", "/docs/", "/example/", "/static/"]
	}
}
